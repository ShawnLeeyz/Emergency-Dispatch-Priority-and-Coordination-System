@page
@model DispatchWeb.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in | Emergency Dispatch</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
<main class="login-main">
    <section class="login-panel">
        <div class="login-brand"><span class="brand-mark">ED</span><div><strong>Emergency Dispatch</strong><small>Priority &amp; Coordination</small></div></div>
        <div class="login-heading"><p class="eyebrow">Prototype demonstration system</p><h1>Sign in</h1><p>Use a demo account to open the interface for that role.</p></div>
        <form method="post" class="login-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>
            <div class="form-field"><label asp-for="Input.Username"></label><input asp-for="Input.Username" autocomplete="username" autofocus /><span asp-validation-for="Input.Username" class="field-validation"></span></div>
            <div class="form-field"><label asp-for="Input.Password"></label><input asp-for="Input.Password" autocomplete="current-password" /><span asp-validation-for="Input.Password" class="field-validation"></span></div>
            <button class="button" type="submit">Sign in</button>
        </form>
        <details class="demo-reference"><summary>View demo account reference</summary><div class="table-wrap"><table><thead><tr><th>Username</th><th>Password</th><th>Access</th></tr></thead><tbody>@foreach (var account in Model.DemoAccounts) { <tr><td><code>@account.Username</code></td><td><code>@account.Password</code></td><td>@account.Role @(account.Scope is null ? "" : $"- {account.Scope}")</td></tr> }</tbody></table></div></details>
        <p class="security-note">Fake plaintext credentials are used only for this university prototype. Do not use real credentials.</p>
    </section>
</main>
</body>
</html>
