@page
@model DispatchWeb.Pages.ErrorModel
@* Displays a safe error message when a request cannot be completed. *@

@{
    ViewData["Title"] = "Something went wrong";
}

<section class="panel">
    <h1>We could not complete that action.</h1>
    <p>Please return to the dashboard and try again. If the problem continues, tell a system administrator what you were doing.</p>
    <a class="button" asp-page="/Index">Return to dashboard</a>
</section>
