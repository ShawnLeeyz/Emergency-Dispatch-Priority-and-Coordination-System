@page "/ResponseUnits/{unit}"
@model DispatchWeb.Pages.ResponseUnits.IndexModel
@{ ViewData["Title"] = $"{Model.Unit.Identifier} assignment"; ViewData["AutoRefresh"] = true; }
<section class="page-heading"><div><p class="eyebrow">Response unit workspace</p><h1>@Model.Unit.Identifier</h1><p>@Model.Unit.Type response unit - @Model.Unit.Location</p></div><span class="badge availability @Model.Unit.Availability.ToString().ToLowerInvariant()">@(Model.Unit.Availability == UnitAvailability.Available ? "Available" : "Not Available")</span></section>
@if (Model.ActiveCase is null)
{
    <section class="panel assignment-panel"><div class="empty-state"><h2>No active assignment</h2><p>@Model.Unit.Identifier is available and waiting for dispatch.</p></div></section>
}
else
{
    <section class="panel assignment-panel"><div class="panel-title"><div><p class="section-kicker">Current assignment</p><h2>@Model.ActiveCase.CaseNumber</h2></div><span class="badge priority @Model.ActiveCase.Priority.ToString().ToLowerInvariant()">@Model.ActiveCase.Priority priority</span></div><dl class="assignment-details"><div><dt>Incident</dt><dd>@Model.ActiveCase.IncidentType</dd></div><div><dt>Location</dt><dd>@Model.ActiveCase.Location</dd></div><div><dt>Status</dt><dd>@(Model.ActiveCase.Status == CaseStatus.InProgress ? "In Progress" : Model.ActiveCase.Status)</dd></div><div><dt>Required response</dt><dd>@string.Join(", ", Model.ActiveCase.RequiredUnitTypes)</dd></div><div class="detail-wide"><dt>Details</dt><dd>@Model.ActiveCase.Description</dd></div></dl><form method="post" asp-page-handler="SignOff" asp-route-unit="@Model.Unit.Identifier" class="signoff-action"><input type="hidden" name="caseId" value="@Model.ActiveCase.Id" /><div><strong>Response complete?</strong><span>Sign off only when this unit has finished its work.</span></div><button class="button" type="submit">Sign off assignment</button></form></section>
}
@if (Model.Notification is not null) { <section class="panel"><div class="panel-title"><div><p class="section-kicker">Latest notification</p><h2>Assignment information</h2></div><time>@Model.Notification.CreatedAt.LocalDateTime.ToString("dd MMM, HH:mm")</time></div><p>@Model.Notification.Message</p></section> }
