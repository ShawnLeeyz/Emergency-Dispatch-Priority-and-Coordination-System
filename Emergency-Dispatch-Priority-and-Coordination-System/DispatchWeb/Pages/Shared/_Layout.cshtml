<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | Emergency Dispatch</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="header-inner">
            @{ var home = User.IsInRole(DemoRoles.Admin) ? "/Admin" : User.IsInRole(DemoRoles.Department) ? $"/Departments/{User.Scope()}" : User.IsInRole(DemoRoles.ResponseUnit) ? $"/ResponseUnits/{User.Scope()}" : "/"; }
            <a class="brand" href="@home" aria-label="Emergency Dispatch home"><span class="brand-mark">ED</span><span>Emergency Dispatch<small>Priority &amp; Coordination</small></span></a>
            <nav class="primary-nav" aria-label="Primary navigation">
                @if (User.IsInRole(DemoRoles.Dispatcher))
                {
                    <a asp-page="/Index">Dashboard</a><a asp-page="/Cases/Create">Record emergency</a><a asp-page="/History">History</a>
                }
                else if (User.IsInRole(DemoRoles.Department))
                {
                    <a asp-page="/Departments/Dashboard" asp-route-department="@User.Scope()">Dashboard</a><a asp-page="/Units" asp-route-department="@User.Scope()">Units</a>
                }
                else if (User.IsInRole(DemoRoles.ResponseUnit))
                {
                    <a asp-page="/ResponseUnits/Index" asp-route-unit="@User.Scope()">My assignment</a>
                }
                else if (User.IsInRole(DemoRoles.Admin))
                {
                    <a asp-page="/Admin/Index">Admin home</a><a asp-page="/Index">Dispatcher</a><a asp-page="/Units">Units</a><a asp-page="/History">History</a>
                }
            </nav>
            <div class="user-menu"><div><strong>@User.DisplayName()</strong><span>@User.Role()@(string.IsNullOrWhiteSpace(User.Scope()) ? "" : $" - {User.Scope()}")</span></div><form method="post" asp-page="/Account/Logout"><button type="submit">Log out</button></form></div>
        </div>
    </header>

    <main id="main-content">
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success" role="status"><strong>Updated.</strong> @success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-error" role="alert"><strong>Action not completed.</strong> @error</div>
        }
        @RenderBody()
    </main>

    <footer><span>Emergency Dispatch prototype</span><span>Role-based demonstration environment</span></footer>

    @if (ViewData["AutoRefresh"] as bool? == true)
    {
        <script>
            document.querySelectorAll("form").forEach(function (form) {
                form.addEventListener("input", function () { form.dataset.dirty = "true"; });
            });
            window.setInterval(function () {
                if (document.visibilityState === "visible" && !document.querySelector("form[data-dirty='true']")) {
                    window.location.reload();
                }
            }, 5000);
        </script>
    }
</body>
</html>
