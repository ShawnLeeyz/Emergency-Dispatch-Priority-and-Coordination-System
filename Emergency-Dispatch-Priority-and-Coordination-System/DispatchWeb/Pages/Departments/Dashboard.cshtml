@page "/Departments/{department}"
@model DispatchWeb.Pages.Departments.DashboardModel

@{
    ViewData["Title"] = $"{Model.Department.Name} dashboard";
    ViewData["AutoRefresh"] = true;
    var waitingCases = Model.Cases.Where(c => c.IsWaitingFor(Model.DepartmentType)).ToArray();
    var coveredCases = Model.Cases.Where(c => !c.IsWaitingFor(Model.DepartmentType)).ToArray();
}

<header class="page-heading">
    <div><p class="eyebrow">@Model.Department.Name department</p><h1>@Model.Department.Name Dashboard</h1><p>Current cases and response-unit availability for @Model.Department.Name.</p></div>
    <div class="heading-actions"><span class="live-indicator"><span></span> Live updates</span><a class="button button-secondary" asp-page="/Units" asp-route-department="@Model.DepartmentType">Manage Units</a></div>
</header>

@if (waitingCases.Any())
{
    <section class="work-section attention-section">
        <div class="section-heading"><div><p class="section-kicker">Needs attention</p><h2>Waiting for @Model.Department.Name unit</h2><p>No @Model.Department.Name.ToLowerInvariant() unit is currently available.</p></div><strong>@waitingCases.Length waiting</strong></div>
        <div class="table-wrap"><table class="case-table"><thead><tr><th>Case</th><th>Incident and location</th><th>Priority</th><th>Other response</th><th>Current state</th></tr></thead><tbody>
        @foreach (var dispatchCase in waitingCases)
        {
            <tr><td><strong class="case-number">@dispatchCase.CaseNumber</strong><small>@dispatchCase.RecordedAt.LocalDateTime.ToString("dd MMM, HH:mm")</small></td><td><strong>@dispatchCase.IncidentType</strong><small>@dispatchCase.Location</small></td><td><span class="badge priority @dispatchCase.Priority.ToString().ToLowerInvariant()">@dispatchCase.Priority</span></td><td>@string.Join(", ", dispatchCase.RequiredUnitTypes.Where(t => t != Model.DepartmentType))</td><td><span class="state-label waiting">Waiting for @Model.Department.Name</span></td></tr>
        }
        </tbody></table></div>
    </section>
}

<section class="work-section">
    <div class="section-heading"><div><p class="section-kicker">Current workload</p><h2>Cases requiring @Model.Department.Name</h2><p>Assigned and completed response work for this department.</p></div><strong>@coveredCases.Length current</strong></div>
    @if (!coveredCases.Any())
    {
        <div class="empty-state"><h3>No active @Model.Department.Name cases</h3><p>New cases requiring this department will appear here automatically.</p></div>
    }
    else
    {
        <div class="table-wrap"><table class="case-table"><thead><tr><th>Case</th><th>Incident and location</th><th>Priority</th><th>Unit</th><th>Department response</th></tr></thead><tbody>
        @foreach (var dispatchCase in coveredCases)
        {
            var activeUnit = dispatchCase.AssignedUnits.SingleOrDefault(unit => unit.Type == Model.DepartmentType);
            var completed = dispatchCase.Assignments.SingleOrDefault(a => a.Unit.Type == Model.DepartmentType && !a.IsActive);
            <tr><td><strong class="case-number">@dispatchCase.CaseNumber</strong><small>@dispatchCase.RecordedAt.LocalDateTime.ToString("dd MMM, HH:mm")</small></td><td><strong>@dispatchCase.IncidentType</strong><small>@dispatchCase.Location</small></td><td><span class="badge priority @dispatchCase.Priority.ToString().ToLowerInvariant()">@dispatchCase.Priority</span></td><td><strong>@(activeUnit?.Identifier ?? completed?.Unit.Identifier ?? "Not assigned")</strong></td><td>@if (activeUnit is not null) { <span class="state-label active">Response active</span> } else { <span class="state-label complete">Signed off</span> }</td></tr>
        }
        </tbody></table></div>
    }
</section>

<section class="secondary-section">
    <div class="section-heading"><div><h2>Response units</h2><p>Availability is controlled by assignment and sign-off.</p></div><a asp-page="/Units" asp-route-department="@Model.DepartmentType">Edit unit details</a></div>
    <div class="table-wrap"><table class="compact-table"><thead><tr><th>Unit</th><th>Status</th><th>Location</th><th>Personnel</th></tr></thead><tbody>@foreach (var unit in Model.Department.Units) { <tr><td><strong>@unit.Identifier</strong></td><td><span class="badge availability @unit.Availability.ToString().ToLowerInvariant()">@(unit.Availability == UnitAvailability.Available ? "Available" : "Not Available")</span></td><td>@unit.Location</td><td>@unit.PersonnelCount</td></tr> }</tbody></table></div>
</section>

<section class="secondary-section">
    <div class="section-heading"><div><h2>Assignment notifications</h2><p>Latest dispatch messages sent to this department's units.</p></div></div>
    @if (!Model.Notifications.Any()) { <p class="empty-inline">No assignment notifications for @Model.Department.Name.</p> }
    else { <ul class="activity-list">@foreach (var notification in Model.Notifications) { <li><div><strong>@notification.UnitIdentifier</strong><span>@notification.CaseNumber · @notification.IncidentType</span></div><time>@notification.CreatedAt.LocalDateTime.ToString("dd MMM, HH:mm")</time></li> }</ul> }
</section>
