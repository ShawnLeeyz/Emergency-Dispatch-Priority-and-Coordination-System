@page
@model HistoryModel

@{
    ViewData["Title"] = "Case history";
}

<section class="page-heading">
    <div>
        <p class="eyebrow">FR-12</p>
        <h1>Case history</h1>
        <p>Search by case number or caller name and optionally narrow results to a recorded date.</p>
    </div>
</section>

<section class="panel">
    <form method="get" class="search">
        <input asp-for="Search" placeholder="Case number or caller name" />
        <input asp-for="Date" type="date" />
        <button class="button" type="submit">Search logs</button>
    </form>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Case</th>
                    <th>Caller</th>
                    <th>Recorded</th>
                    <th>Priority</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Cases.Any())
                {
                    <tr><td colspan="5" class="empty">No matching case logs.</td></tr>
                }
                @foreach (var dispatchCase in Model.Cases)
                {
                    <tr>
                        <td><strong>@dispatchCase.CaseNumber</strong></td>
                        <td>@dispatchCase.CallerName</td>
                        <td>@dispatchCase.RecordedAt.LocalDateTime.ToString("dd MMM yyyy HH:mm")</td>
                        <td><span class="priority @dispatchCase.Priority.ToString().ToLowerInvariant()">@dispatchCase.Priority</span></td>
                        <td><span class="status">@dispatchCase.Status</span></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
