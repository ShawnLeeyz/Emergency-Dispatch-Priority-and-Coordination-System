@page
@model HistoryModel

@{
    ViewData["Title"] = "Case history";
    var hasSearch = !string.IsNullOrWhiteSpace(Model.CallerName) || !string.IsNullOrWhiteSpace(Model.CaseId) || Model.Date.HasValue;
}

<header class="page-heading"><div><p class="eyebrow">Dispatcher records</p><h1>Case History</h1><p>Search previous emergency cases by caller, case ID, or date.</p></div></header>

<section class="search-section">
    <form method="get" class="search-form">
        <div class="form-field"><label asp-for="CallerName">Caller name</label><input asp-for="CallerName" placeholder="e.g. Alex Morgan" /></div>
        <div class="form-field"><label asp-for="CaseId">Case ID</label><input asp-for="CaseId" placeholder="CASE-1234ABCD" /></div>
        <div class="form-field"><label asp-for="Date">Recorded date</label><input asp-for="Date" type="date" /></div>
        <div class="search-actions"><button class="button" type="submit">Search</button>@if (hasSearch) { <a class="button button-secondary" asp-page="/History">Clear</a> }</div>
    </form>
    <p class="form-note">A case is returned when any entered field matches.</p>
</section>

<section class="work-section">
    <div class="section-heading"><div><h2>@(hasSearch ? "Search results" : "All cases")</h2><p>@(hasSearch ? "Cases matching at least one search field." : "Current and completed emergency records.")</p></div><strong>@Model.Cases.Count found</strong></div>
    @if (!Model.Cases.Any())
    {
        <div class="empty-state"><h3>No matching cases</h3><p>Check the search details or clear the fields to view all records.</p></div>
    }
    else
    {
        <div class="table-wrap"><table class="case-table"><thead><tr><th>Case</th><th>Recorded</th><th>Caller</th><th>Incident and location</th><th>Priority</th><th>Status</th></tr></thead><tbody>@foreach (var dispatchCase in Model.Cases) { <tr><td><strong class="case-number">@dispatchCase.CaseNumber</strong><small>@string.Join(", ", dispatchCase.RequiredUnitTypes)</small></td><td>@dispatchCase.RecordedAt.LocalDateTime.ToString("dd MMM yyyy")<small>@dispatchCase.RecordedAt.LocalDateTime.ToString("HH:mm")</small></td><td><strong>@dispatchCase.CallerName</strong><small>@dispatchCase.CallerPhone</small></td><td><strong>@dispatchCase.IncidentType</strong><small>@dispatchCase.Location</small></td><td><span class="badge priority @dispatchCase.Priority.ToString().ToLowerInvariant()">@dispatchCase.Priority</span></td><td><span class="badge status @dispatchCase.Status.ToString().ToLowerInvariant()">@(dispatchCase.Status == CaseStatus.InProgress ? "In Progress" : dispatchCase.Status)</span></td></tr> }</tbody></table></div>
    }
</section>
