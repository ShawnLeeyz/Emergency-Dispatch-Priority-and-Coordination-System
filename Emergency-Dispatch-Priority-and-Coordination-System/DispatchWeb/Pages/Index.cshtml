@page
@model IndexModel

@{
    ViewData["Title"] = "Dispatcher dashboard";
    ViewData["AutoRefresh"] = true;
    var waitingCases = Model.Cases.Where(c => c.Status != CaseStatus.Closed && c.WaitingUnitTypes.Any()).ToArray();
    var respondingCases = Model.Cases.Where(c => c.Status == CaseStatus.InProgress && !c.WaitingUnitTypes.Any()).ToArray();
}

@if (!string.IsNullOrWhiteSpace(Request.Query["created"]))
{
    <div class="alert alert-success" role="status"><strong>@Request.Query["created"] created successfully.</strong> Routing and available-unit assignment are complete.</div>
}

<header class="page-heading">
    <div><p class="eyebrow">Dispatcher</p><h1>Dashboard</h1><p>Monitor current emergency cases and response progress.</p></div>
    <div class="heading-actions"><span class="live-indicator"><span></span> Live updates</span><a class="button" asp-page="/Cases/Create">Record Emergency</a></div>
</header>

@if (waitingCases.Any())
{
    <section class="work-section attention-section">
        <div class="section-heading"><div><p class="section-kicker">Needs attention</p><h2>Waiting for response units</h2><p>No compatible unit is currently available for one or more required responses.</p></div><strong>@waitingCases.Length waiting</strong></div>
        <div class="table-wrap"><table class="case-table"><thead><tr><th>Case</th><th>Incident and location</th><th>Priority</th><th>Required response</th><th>Assigned</th><th>Current state</th></tr></thead><tbody>
        @foreach (var dispatchCase in waitingCases)
        {
            <tr><td><strong class="case-number">@dispatchCase.CaseNumber</strong><small>@dispatchCase.RecordedAt.LocalDateTime.ToString("dd MMM, HH:mm")</small></td><td><strong>@dispatchCase.IncidentType</strong><small>@dispatchCase.Location</small></td><td><span class="badge priority @dispatchCase.Priority.ToString().ToLowerInvariant()">@dispatchCase.Priority</span></td><td>@string.Join(", ", dispatchCase.RequiredUnitTypes)</td><td>@(dispatchCase.AssignedUnits.Any() ? string.Join(", ", dispatchCase.AssignedUnits.Select(u => u.Identifier)) : "None")</td><td><span class="state-label waiting">Waiting for @string.Join(" / ", dispatchCase.WaitingUnitTypes)</span></td></tr>
        }
        </tbody></table></div>
    </section>
}

<section class="work-section">
    <div class="section-heading"><div><p class="section-kicker">Current work</p><h2>Active responses</h2><p>Cases with all required departments currently covered.</p></div><strong>@respondingCases.Length active</strong></div>
    @if (!respondingCases.Any())
    {
        <div class="empty-state"><h3>No active responses</h3><p>Cases appear here after all required units are assigned.</p></div>
    }
    else
    {
        <div class="table-wrap"><table class="case-table"><thead><tr><th>Case</th><th>Incident and location</th><th>Priority</th><th>Required response</th><th>Assigned units</th><th>Status</th></tr></thead><tbody>
        @foreach (var dispatchCase in respondingCases)
        {
            <tr><td><strong class="case-number">@dispatchCase.CaseNumber</strong><small>@dispatchCase.RecordedAt.LocalDateTime.ToString("dd MMM, HH:mm")</small></td><td><strong>@dispatchCase.IncidentType</strong><small>@dispatchCase.Location</small></td><td><span class="badge priority @dispatchCase.Priority.ToString().ToLowerInvariant()">@dispatchCase.Priority</span></td><td>@string.Join(", ", dispatchCase.RequiredUnitTypes)</td><td><strong>@string.Join(", ", dispatchCase.AssignedUnits.Select(u => u.Identifier))</strong></td><td><span class="badge status inprogress">In Progress</span></td></tr>
        }
        </tbody></table></div>
    }
</section>

<section class="secondary-section">
    <div class="section-heading"><div><h2>Recent assignments</h2><p>Latest notifications sent to response units.</p></div></div>
    @if (!Model.Notifications.Any()) { <p class="empty-inline">No assignments have been issued.</p> }
    else { <ul class="activity-list">@foreach (var notification in Model.Notifications) { <li><div><strong>@notification.UnitIdentifier</strong><span>@notification.CaseNumber · @notification.IncidentType</span></div><time>@notification.CreatedAt.LocalDateTime.ToString("dd MMM, HH:mm")</time></li> }</ul> }
</section>
